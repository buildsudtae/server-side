{
  "info": {
    "name": "ToDo API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create Task",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Learn Coding\",\n  \"status\": \"Draft\",\n  \"created_by\": \"anonymous\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Task is created as Draft\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.description).to.eql(\"Learn Coding\");",
              "    pm.expect(json.status).to.eql(\"Draft\");",
              "    pm.expect(json).to.have.property(\"id\");",
              "    pm.collectionVariables.set(\"taskId\", json.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is an array\", function () {",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");",
              "});",
              "pm.test(\"Response time < 1000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});",
              "",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.response.to.have.header(\"Content-Type\");",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get task by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200 and has description\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json()).to.have.property(\"description\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get task not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/99999"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Unknown task returns 404\", function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update task (id 100 in body)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 100,\n  \"description\": \"Test Modified\",\n  \"status\": \"In Progress\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Update keeps ID from URL (not from body)\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.id).to.eql(pm.collectionVariables.get(\"taskId\"));",
              "    pm.expect(json.status).to.eql(\"In Progress\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Query by status",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks?status=In%20Progress"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"All results are In Progress\", function () {",
              "    pm.response.json().forEach(function (t) {",
              "        pm.expect(t.status).to.eql(\"In Progress\");",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete without auth",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Delete without token -> 401\", function () {",
              "    pm.response.to.have.status(401);",
              "    pm.expect(pm.response.json().detail).to.eql(\"Not authenticated\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login user1",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/token",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "user1"
            },
            {
              "key": "password",
              "value": "12345"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login success returns access_token\", function () {",
              "    pm.response.to.have.status(200);",
              "    const json = pm.response.json();",
              "    pm.expect(json.token_type).to.eql(\"bearer\");",
              "    pm.collectionVariables.set(\"token\", json.access_token);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get me",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/user/me",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"/user/me returns user1\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().username).to.eql(\"user1\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Modify user2 as user1",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/user/user2",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"user2\",\n  \"password\": \"newpassword\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"user1 cannot modify user2 -> 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Find 500 error",
      "request": {
        "method": "PUT",
        "header": [],
        "url": "{{baseUrl}}/tasks/99999",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"x\",\n  \"status\": \"Draft\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"BUG: PUT on missing task gives 500 (should be 404)\", function () {",
              "    pm.response.to.have.status(500);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}